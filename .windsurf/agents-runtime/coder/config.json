{
  "agent": {
    "name": "claude_cascade",
    "version": "1.0.0",
    "type": "primary_llm",
    "description": "Moi (cascade) utilisant mes skills de codage via MCP"
  },
  "runtime": {
    "port": 3011,
    "protocol": "http",
    "max_concurrent_tasks": 8,
    "task_timeout": 600000
  },
  "my_skills_for_coding": {
    "primary": ["ai-engineer", "backend-architect"],
    "support": ["testing-patterns", "debugging-strategies"],
    "workflow": ["conductor-new-track", "git-pr-workflows-git-workflow"]
  },
  "capabilities": [
    "code_generation",
    "implementation",
    "refactoring",
    "optimization",
    "debugging",
    "testing"
  ],
  "skill_execution": {
    "when_coding": {
      "analyze_requirements": "backend-architect",
      "write_code": "ai-engineer",
      "add_tests": "testing-patterns",
      "debug_issues": "debugging-strategies",
      "manage_workflow": "conductor-new-track"
    },
    "mcp_tools_used": [
      "filesystem",
      "memory",
      "cache",
      "sequentialthinking"
    ]
  },
  "languages": {
    "primary": ["javascript", "typescript", "python"],
    "secondary": ["java", "go", "rust", "csharp"],
    "config": {
      "javascript": {
        "formatter": "prettier",
        "linter": "eslint",
        "package_manager": "npm",
        "test_framework": "jest"
      },
      "typescript": {
        "formatter": "prettier",
        "linter": "eslint",
        "package_manager": "npm",
        "test_framework": "jest",
        "strict_mode": true
      },
      "python": {
        "formatter": "black",
        "linter": "pylint",
        "package_manager": "pip",
        "test_framework": "pytest",
        "type_checker": "mypy"
      }
    }
  },
  "code_generation": {
    "templates": {
      "component": "./templates/component.template",
      "service": "./templates/service.template",
      "test": "./templates/test.template",
      "config": "./templates/config.template"
    },
    "memory_integration": {
      "use_code_patterns": true,
      "search_similar_code": true,
      "learn_from_feedback": true
    }
  },
  "quality": {
    "code_review": {
      "enabled": true,
      "auto_fix": true,
      "rules": "./quality_rules.json",
      "skill_used": "code-reviewer"
    },
    "testing": {
      "coverage_threshold": 80,
      "auto_generate_tests": true,
      "test_types": ["unit", "integration", "e2e"],
      "skill_used": "testing-patterns"
    },
    "security": {
      "scan_enabled": true,
      "vulnerability_check": true,
      "secrets_detection": true,
      "skill_used": "security-auditor"
    }
  },
  "workspace": {
    "root": "./workspace/",
    "max_size": "1GB",
    "cleanup_interval": 3600000,
    "backup": {
      "enabled": true,
      "interval": 1800000,
      "retention": 10
    },
    "filesystem_mcp": "filesystem",
    "allowed_paths": ["Promgramation-teste", "workspace"]
  },
  "dependencies": {
    "package_managers": {
      "npm": {
        "registry": "https://registry.npmjs.org",
        "timeout": 30000
      },
      "pip": {
        "index_url": "https://pypi.org/simple",
        "timeout": 30000
      }
    },
    "cache": {
      "enabled": true,
      "path": "./cache/",
      "max_size": "500MB"
    }
  },
  "memory_layers": {
    "cache": {
      "use_for": ["current_task", "skill_state", "temporary_results"],
      "ttl": 3600
    },
    "working": {
      "use_for": ["session_code", "debugging_history", "skill_usage"],
      "database": "memory_mcp.db"
    },
    "persistent": {
      "use_for": ["code_patterns", "solutions", "skill_effectiveness"],
      "vector_engines": ["qdrant", "zvec"]
    }
  },
  "reasoning": {
    "engine": "sequentialthinking",
    "use_for_complex_tasks": true,
    "min_steps": 3,
    "max_steps": 10
  },
  "git": {
    "auto_commit": false,
    "branch_strategy": "feature-branch",
    "commit_template": "./templates/commit.txt",
    "pre_commit_hooks": ["lint", "test", "security-scan"],
    "workflow_skill": "git-pr-workflows-git-workflow"
  },
  "monitoring": {
    "metrics": {
      "files_generated": "counter",
      "lines_of_code": "counter",
      "bugs_fixed": "counter",
      "test_coverage": "gauge",
      "skill_usage": "counter"
    },
    "profiling": {
      "enabled": true,
      "cpu_threshold": 80,
      "memory_threshold": 70
    }
  }
}