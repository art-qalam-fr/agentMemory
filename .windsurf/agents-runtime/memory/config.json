{
  "agent": {
    "name": "memory",
    "version": "1.0.0",
    "type": "knowledge_manager",
    "description": "Agent de gestion de la mémoire et des connaissances"
  },
  "runtime": {
    "port": 3014,
    "protocol": "http",
    "max_concurrent_operations": 20,
    "operation_timeout": 60000
  },
  "capabilities": [
    "information_storage",
    "context_retrieval",
    "learning",
    "knowledge_indexing",
    "memory_consolidation"
  ],
  "storage_layers": {
    "cache": {
      "type": "redis",
      "host": "localhost",
      "port": 6379,
      "ttl": 3600,
      "max_size": "1GB",
      "eviction_policy": "lru"
    },
    "working_memory": {
      "type": "sqlite",
      "path": "./working_memory.db",
      "max_size": "100MB",
      "retention": "7d"
    },
    "long_term_memory": {
      "type": "vector",
      "provider": "zvec",
      "dimension": 3072,
      "max_vectors": 1000000
    },
    "episodic_memory": {
      "type": "graph",
      "database": "./episodic.db",
      "max_nodes": 100000
    }
  },
  "memory_types": {
    "declarative": {
      "storage": "long_term_memory",
      "indexing": true,
      "compression": true
    },
    "procedural": {
      "storage": "working_memory",
      "caching": true,
      "auto_refresh": false
    },
    "episodic": {
      "storage": "episodic_memory",
      "temporal_indexing": true,
      "emotion_tagging": false
    },
    "semantic": {
      "storage": "long_term_memory",
      "concept_linking": true,
      "hierarchy": true
    }
  },
  "operations": {
    "store": {
      "validation": true,
      "deduplication": true,
      "auto_tagging": true,
      "compression_threshold": "10KB"
    },
    "retrieve": {
      "max_results": 100,
      "similarity_threshold": 0.7,
      "include_metadata": true,
      "ranking": "hybrid"
    },
    "update": {
      "versioning": true,
      "diff_storage": true,
      "conflict_resolution": "merge"
    },
    "delete": {
      "soft_delete": true,
      "retention_period": "30d",
      "cascade": false
    }
  },
  "indexing": {
    "auto_index": true,
    "batch_size": 100,
    "update_interval": 300,
    "strategies": {
      "full_text": {
        "enabled": true,
        "analyzer": "standard"
      },
      "semantic": {
        "enabled": true,
        "model": "text-embedding-3-large"
      },
      "temporal": {
        "enabled": true,
        "granularity": "day"
      },
      "hierarchical": {
        "enabled": true,
        "max_depth": 5
      }
    }
  },
  "learning": {
    "pattern_recognition": {
      "enabled": true,
      "min_occurrences": 3,
      "confidence_threshold": 0.8
    },
    "association_mining": {
      "enabled": true,
      "min_support": 0.1,
      "min_confidence": 0.7
    },
    "anomaly_detection": {
      "enabled": true,
      "method": "isolation_forest",
      "threshold": 0.95
    }
  },
  "consolidation": {
    "schedule": "0 2 * * *",
    "strategies": {
      "forgetting_curve": {
        "enabled": true,
        "half_life": "30d",
        "strength_factor": 0.9
      },
      "importance_weighting": {
        "enabled": true,
        "factors": ["frequency", "recency", "utility"]
      },
      "compression": {
        "enabled": true,
        "ratio": 0.5,
        "preserve_structure": true
      }
    }
  },
  "api": {
    "endpoints": {
      "store": "/memory/store",
      "retrieve": "/memory/retrieve",
      "search": "/memory/search",
      "update": "/memory/update",
      "delete": "/memory/delete",
      "stats": "/memory/stats",
      "consolidate": "/memory/consolidate"
    },
    "rate_limiting": {
      "requests_per_minute": 1000,
      "burst_size": 100
    },
    "authentication": {
      "required": false,
      "api_key_header": "X-Memory-API-Key"
    }
  },
  "monitoring": {
    "metrics": {
      "storage_usage": "gauge",
      "operation_latency": "histogram",
      "cache_hit_rate": "gauge",
      "memory_efficiency": "gauge"
    },
    "alerts": {
      "storage_full": {
        "threshold": 90,
        "action": "cleanup"
      },
      "performance_degradation": {
        "threshold": 2.0,
        "action": "optimize"
      }
    }
  }
}